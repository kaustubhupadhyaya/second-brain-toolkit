# NON-SECRET config only. Copy to .env and edit paths/labels.
# This file intentionally has NO password / MFA / token fields.
# Passwords are never stored for this project: browser logins happen
# manually via export-clicker/login_once.py (persistent profile cookies only).

# Where converters write markdown (staging; promote to vault afterwards)
SECOND_BRAIN_OUT=C:\SecondBrainStaging\SecondBrain\chats

# Account labels (used only for output subfolders, e.g. chatgpt/<label>)
CHATGPT_LABELS=acct1
CLAUDE_LABELS=acct1

# YouTube pull (OAuth client files live outside git; paths only, no secrets)
YOUTUBE_CLIENT_SECRETS=
